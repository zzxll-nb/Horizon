{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon.local/schemas/dashboard-snapshot-1.2.json",
  "title": "DashboardSnapshot",
  "description": "Horizon 与 AI 全球情报工作台之间的数据契约。所有时间均为 UTC ISO 8601。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_status",
    "generated_at",
    "period_start",
    "period_end",
    "briefing",
    "news",
    "categories",
    "market"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "data_status": {"type": "string", "enum": ["live", "sample"]},
    "fixture_note": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "period_start": {"type": "string", "format": "date-time"},
    "period_end": {"type": "string", "format": "date-time"},
    "briefing": {"$ref": "#/$defs/briefing"},
    "news": {
      "type": "array",
      "items": {"$ref": "#/$defs/news_event"}
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/category"}
    },
    "market": {
      "type": ["object", "null"],
      "description": "预留的市场数据扩展位；1.0 阶段必须为 null。"
    }
  },
  "$defs": {
    "category_id": {
      "type": "string",
      "enum": ["markets", "finance", "investing", "macro", "tech_ai"]
    },
    "category": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"const": "markets"}, "display_name": {"const": "市场"}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"const": "finance"}, "display_name": {"const": "财经"}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"const": "investing"}, "display_name": {"const": "投资"}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"const": "macro"}, "display_name": {"const": "宏观"}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "display_name"], "properties": {"id": {"const": "tech_ai"}, "display_name": {"const": "科技 / AI"}}}
      ]
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "level": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "high=80–100，medium=50–79，low=0–49。"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "published_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "published_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "news_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_cn",
        "title_original",
        "summary",
        "analysis",
        "why_important",
        "watch_factors",
        "related_assets",
        "category",
        "importance",
        "published_at",
        "updated_at",
        "sources",
        "primary_source",
        "primary_url"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_cn": {"type": "string", "minLength": 1},
        "title_original": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1},
        "analysis": {"type": "string", "minLength": 700},
        "why_important": {"type": ["string", "null"]},
        "watch_factors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "related_assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "content_kind": {"type": "string", "enum": ["news", "background_research"]},
        "category": {"$ref": "#/$defs/category_id"},
        "importance": {"$ref": "#/$defs/importance"},
        "published_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "primary_source": {"type": "string", "minLength": 1},
        "primary_url": {"type": "string", "format": "uri"}
      }
    },
    "briefing_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_cn", "summary", "why_important", "category", "importance", "source_count", "source_names", "published_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_cn": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "why_important": {"type": ["string", "null"]},
        "content_kind": {"type": "string", "enum": ["news", "background_research"]},
        "category": {"$ref": "#/$defs/category_id"},
        "importance": {"$ref": "#/$defs/importance"},
        "source_count": {"type": "integer", "minimum": 1},
        "source_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "published_at": {"type": "string", "format": "date-time"}
      }
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "events"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/briefing_event"}
        }
      }
    }
  }
}
